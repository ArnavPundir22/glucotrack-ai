# GlucoTrack AI Environment Configuration
PORT=5000
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
JWT_SECRET=your_jwt_secret_here

# Database Configuration (Leave commented out for local SQLite, or set for Supabase PostgreSQL)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Email Delivery Configuration for Render / Cloud Deployment
# Option A: Resend HTTP API (Recommended for Render - works over HTTPS Port 443)
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=onboarding@resend.dev

# Option B: SendGrid HTTP API (Works over HTTPS Port 443)
# SENDGRID_API_KEY=SG.123456789

# Option C: Standard SMTP (Note: Render blocks outbound SMTP port 25/587 by default)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

